<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>AI News Radar RSS Feeds</title>
  </head>
  <body>
    <outline text="Global News">
      <outline
        text="The Guardian"
        title="The Guardian"
        type="rss"
        xmlUrl="https://www.theguardian.com/world/rss"
        htmlUrl="https://www.theguardian.com"
      />
      <outline
        text="NPR"
        title="NPR"
        type="rss"
        xmlUrl="https://feeds.npr.org/1001/rss.xml"
        htmlUrl="https://www.npr.org"
      />
      <outline
        text="BBC News"
        title="BBC News"
        type="rss"
        xmlUrl="https://feeds.bbci.co.uk/news/rss.xml"
        htmlUrl="https://www.bbc.com/news"
      />
    </outline>
    <outline text="AI News">
      <outline
        text="OpenAI News"
        title="OpenAI News"
        type="rss"
        xmlUrl="https://openai.com/news/rss.xml"
        htmlUrl="https://openai.com/news"
      />
      <outline
        text="Hugging Face Blog"
        title="Hugging Face Blog"
        type="rss"
        xmlUrl="https://huggingface.co/blog/feed.xml"
        htmlUrl="https://huggingface.co/blog"
      />
      <outline
        text="Google DeepMind Blog"
        title="Google DeepMind Blog"
        type="rss"
        xmlUrl="https://deepmind.google/blog/rss.xml"
        htmlUrl="https://deepmind.google/discover/blog/"
      />
      <outline
        text="Google AI Blog"
        title="Google AI Blog"
        type="rss"
        xmlUrl="https://blog.google/technology/ai/rss/"
        htmlUrl="https://blog.google/technology/ai/"
      />
      <outline
        text="Microsoft AI Blog"
        title="Microsoft AI Blog"
        type="rss"
        xmlUrl="https://news.microsoft.com/source/topics/ai/feed/"
        htmlUrl="https://news.microsoft.com/source/topics/ai/"
      />
    </outline>
    <outline text="Europe Energy Storage">
      <outline
        text="PV Magazine"
        title="PV Magazine"
        type="rss"
        xmlUrl="https://www.pv-magazine.com/feed/"
        htmlUrl="https://www.pv-magazine.com"
      />
      <outline
        text="Energy Storage News"
        title="Energy Storage News"
        type="rss"
        xmlUrl="https://www.energy-storage.news/feed/"
        htmlUrl="https://www.energy-storage.news"
      />
      <outline
        text="CleanTechnica"
        title="CleanTechnica"
        type="rss"
        xmlUrl="https://cleantechnica.com/feed/"
        htmlUrl="https://cleantechnica.com"
      />
    </outline>
  </body>
</opml>
